rules_version = '2';

// Security rules for the winecellar-fa733 Firestore database.
//
// This file is a checked-in copy of what is deployed in the Firebase console
// (Firestore Database → Rules). Nothing in this repo deploys it — there is no
// Firebase CLI setup here and the app is a single static page — so if the rules
// are ever changed in the console, update this file to match. (Golf Handicap's
// file, with the collection renamed.)
service cloud.firestore {
  match /databases/{database}/documents {

    // Sync stores one document per signed-in user, holding { state, updatedAt }.
    // The {uid} path segment is the user's Firebase auth UID, so comparing it to
    // request.auth.uid is what confines each account to its own cellar — a rule
    // of just `request.auth != null` would let any signed-in Google account read
    // every other user's wines, while refusing anonymous callers identically, so
    // the difference is invisible from outside.
    match /winecellar/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Label photos (2026-10-24): one small JPEG per wine, beside the cellar
    // document rather than in it, because a document is capped at 1 MB. The
    // rule above does NOT reach this path — a match covers its own document,
    // not the ones under it — so it has its own, with the same uid check and
    // a shape and size cap so this path can only ever hold a photo.
    match /winecellar/{uid}/photos/{photoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 300000
        && request.resource.data.data.matches('data:image/jpeg;base64,.*');
    }

    // Everything else is denied by default: there is deliberately no
    // `match /{document=**}` catch-all, and the app touches no other paths.
  }
}
